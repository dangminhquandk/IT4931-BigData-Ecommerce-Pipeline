# Cấu hình HDFS cho môi trường thử nghiệm Docker
CORE_CONF_fs_defaultFS=hdfs://namenode:9000
CORE_CONF_hadoop_http_staticuser_user=root
CORE_CONF_io_file_buffer_size=131072

# Replication = 1 (do cụm thử nghiệm có 1 DataNode)
HDFS_CONF_dfs_replication=1

# Block size chuẩn = 128MB (134217728 bytes) theo hồ sơ kiến trúc
HDFS_CONF_dfs_blocksize=134217728

# Cho phép WebHDFS và bỏ kiểm tra phân quyền để thuận tiện submit job
HDFS_CONF_dfs_webhdfs_enabled=true
HDFS_CONF_dfs_permissions_enabled=false
HDFS_CONF_dfs_namenode_datanode_registration_ip___hostname___check=false

